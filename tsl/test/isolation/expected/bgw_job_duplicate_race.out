step s2_update_stat: 
    BEGIN;
    UPDATE _timescaledb_internal.bgw_job_stat s
    SET total_runs = total_runs + 1
    FROM _timescaledb_catalog.bgw_job j
    WHERE j.id = s.job_id AND j.proc_name = 'test_job_proc_race';

