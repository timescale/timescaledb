-- ORDER BY ... LIMIT 1 is answered from the first row of each batch
\c :TEST_DBNAME :ROLE_SUPERUSER
SET max_parallel_workers_per_gather = 0;
SET timescaledb.enable_deferred_chunk_append = off;

CREATE TABLE limit_one(time timestamptz NOT NULL, device int NOT NULL, ts2 timestamptz, val float, val2 float)
 WITH (tsdb.hypertable,tsdb.orderby='time,ts2',tsdb.segmentby='device',tsdb.index='firstlast(val2)',tsdb.chunk_interval='1 day');
INSERT INTO limit_one SELECT '2000-01-01'::timestamptz + i * interval '1 minute', d, '2000-01-01'::timestamptz - i * interval '1 minute', i, i
FROM generate_series(1, 2500) i, generate_series(1, 3) d;
SELECT count(compress_chunk(ch)) FROM show_chunks('limit_one') ch;

-- orderby columns with min/max metadata only, with and without NULLs
CREATE TABLE limit_one_minmax(time timestamptz NOT NULL, device int NOT NULL)
 WITH (tsdb.hypertable,tsdb.partition_column='device',tsdb.orderby='time',tsdb.segmentby='device');
CREATE TABLE limit_one_minmax_null(time timestamptz, device int NOT NULL)
 WITH (tsdb.hypertable,tsdb.partition_column='device',tsdb.orderby='time',tsdb.segmentby='device');
CREATE TABLE limit_one_null(time timestamptz, device int NOT NULL)
 WITH (tsdb.hypertable,tsdb.partition_column='device',tsdb.orderby='time',tsdb.segmentby='device');
INSERT INTO limit_one_minmax SELECT '2000-01-01'::timestamptz + i * interval '1 minute', 1 FROM generate_series(1, 10) i;
INSERT INTO limit_one_minmax_null SELECT * FROM limit_one_minmax UNION ALL SELECT NULL, 1;
INSERT INTO limit_one_null SELECT * FROM limit_one_minmax_null;
SELECT count(compress_chunk(ch)) FROM show_chunks('limit_one_minmax') ch;
SELECT count(compress_chunk(ch)) FROM show_chunks('limit_one_minmax_null') ch;
SELECT count(compress_chunk(ch)) FROM show_chunks('limit_one_null') ch;
UPDATE _timescaledb_catalog.compression_settings SET index = '[{"type": "minmax", "column": "time", "source": "orderby"}]'
WHERE relid IN (SELECT show_chunks('limit_one_minmax') UNION ALL SELECT show_chunks('limit_one_minmax_null'));
SELECT format('ALTER TABLE %s DROP COLUMN _ts_meta_v2_first_time, DROP COLUMN _ts_meta_v2_last_time', compress_relid::regclass)
FROM _timescaledb_catalog.compression_settings
WHERE relid IN (SELECT show_chunks('limit_one_minmax') UNION ALL SELECT show_chunks('limit_one_minmax_null')) \gexec
ANALYZE limit_one, limit_one_minmax, limit_one_minmax_null, limit_one_null;

SET timescaledb.enable_columnarscan_metadata_only = on;
EXPLAIN (costs off) SELECT time, device FROM limit_one ORDER BY time LIMIT 1;
SELECT time, device FROM limit_one ORDER BY time LIMIT 1;
EXPLAIN (costs off) SELECT time, device FROM limit_one ORDER BY time DESC LIMIT 1;
SELECT time, device FROM limit_one ORDER BY time DESC LIMIT 1;
EXPLAIN (costs off) SELECT device, time, ts2 FROM limit_one ORDER BY device DESC, time DESC, ts2 DESC LIMIT 1;
SELECT device, time, ts2 FROM limit_one ORDER BY device DESC, time DESC, ts2 DESC LIMIT 1;
EXPLAIN (costs off) SELECT tableoid::regclass, time FROM limit_one WHERE device = 2 ORDER BY time LIMIT 1;
SELECT tableoid::regclass, time FROM limit_one WHERE device = 2 ORDER BY time LIMIT 1;
EXPLAIN (costs off) SELECT time, val2 FROM limit_one ORDER BY time DESC LIMIT 1;
SELECT time, val2 FROM limit_one ORDER BY time DESC LIMIT 1;
EXPLAIN (costs off) SELECT time FROM limit_one_minmax ORDER BY time LIMIT 1;
SELECT time FROM limit_one_minmax ORDER BY time LIMIT 1;
EXPLAIN (costs off) SELECT time FROM limit_one_minmax ORDER BY time DESC LIMIT 1;
SELECT time FROM limit_one_minmax ORDER BY time DESC LIMIT 1;
EXPLAIN (costs off) SELECT time FROM limit_one_null ORDER BY time DESC LIMIT 1;
SELECT time FROM limit_one_null ORDER BY time DESC LIMIT 1;

-- needs decompression
EXPLAIN (costs off) SELECT time, val FROM limit_one ORDER BY time LIMIT 1;
EXPLAIN (costs off) SELECT time FROM limit_one ORDER BY time LIMIT 2;
EXPLAIN (costs off) SELECT time FROM limit_one ORDER BY time LIMIT 1 OFFSET 1;
EXPLAIN (costs off) SELECT time FROM limit_one WHERE val > 1000 ORDER BY time LIMIT 1;
EXPLAIN (costs off) SELECT l1.time FROM limit_one l1, limit_one l2 WHERE l1.time = l2.ts2 ORDER BY l1.time LIMIT 1;
EXPLAIN (costs off) SELECT time FROM limit_one_minmax_null ORDER BY time DESC LIMIT 1;
SELECT time FROM limit_one_minmax_null ORDER BY time DESC LIMIT 1;

-- without ORDER BY any row will do
EXPLAIN (costs off) SELECT time, device FROM limit_one LIMIT 1;
SELECT time, device FROM limit_one LIMIT 1;
EXPLAIN (costs off) SELECT 1 FROM limit_one WHERE device = 3 LIMIT 1;
SELECT 1 FROM limit_one WHERE device = 3 LIMIT 1;
EXPLAIN (costs off) SELECT time FROM limit_one_minmax_null LIMIT 1;
SELECT time FROM limit_one_minmax_null LIMIT 1;
EXPLAIN (costs off) SELECT val FROM limit_one LIMIT 1;

-- results match the decompressed scan
SET timescaledb.enable_columnarscan_metadata_only = off;
SELECT time, device FROM limit_one ORDER BY time LIMIT 1;
SELECT time, device FROM limit_one ORDER BY time DESC LIMIT 1;
SELECT device, time, ts2 FROM limit_one ORDER BY device DESC, time DESC, ts2 DESC LIMIT 1;
SELECT tableoid::regclass, time FROM limit_one WHERE device = 2 ORDER BY time LIMIT 1;
SELECT time, val2 FROM limit_one ORDER BY time DESC LIMIT 1;
SELECT time FROM limit_one_minmax ORDER BY time LIMIT 1;
SELECT time FROM limit_one_minmax ORDER BY time DESC LIMIT 1;
SELECT time FROM limit_one_null ORDER BY time DESC LIMIT 1;
SELECT time, device FROM limit_one LIMIT 1;
SELECT 1 FROM limit_one WHERE device = 3 LIMIT 1;
RESET timescaledb.enable_columnarscan_metadata_only;

DROP TABLE limit_one;
DROP TABLE limit_one_minmax;
DROP TABLE limit_one_minmax_null;
DROP TABLE limit_one_null;

-- more LIMIT 1 cases answered from the first row of each batch
CREATE TABLE limit_one_more(time timestamptz NOT NULL, device int NOT NULL, val int NOT NULL, txt text)
 WITH (tsdb.hypertable,tsdb.orderby='time,val',tsdb.segmentby='device',tsdb.index='firstlast(txt)',tsdb.chunk_interval='1 day');
INSERT INTO limit_one_more SELECT '2000-01-01'::timestamptz + i * interval '1 minute', d, (3 - d) * i,
 (SELECT string_agg(md5((d * 100000 + i * 1000 + j)::text), '') FROM generate_series(1, 300) j)
FROM generate_series(1, 20) i, generate_series(1, 2) d;
SELECT count(compress_chunk(ch)) FROM show_chunks('limit_one_more') ch;

-- orderby DESC column with min/max metadata only
CREATE TABLE limit_one_desc(time timestamptz NOT NULL, device int NOT NULL)
 WITH (tsdb.hypertable,tsdb.partition_column='device',tsdb.orderby='time DESC',tsdb.segmentby='device');
INSERT INTO limit_one_desc SELECT '2000-01-01'::timestamptz + i * interval '1 minute', 1 FROM generate_series(1, 10) i;
SELECT count(compress_chunk(ch)) FROM show_chunks('limit_one_desc') ch;
UPDATE _timescaledb_catalog.compression_settings SET index = '[{"type": "minmax", "column": "time", "source": "orderby"}]'
WHERE relid IN (SELECT show_chunks('limit_one_desc'));
SELECT format('ALTER TABLE %s DROP COLUMN _ts_meta_v2_first_time, DROP COLUMN _ts_meta_v2_last_time', compress_relid::regclass)
FROM _timescaledb_catalog.compression_settings
WHERE relid IN (SELECT show_chunks('limit_one_desc')) \gexec
ANALYZE limit_one_more, limit_one_desc;

CREATE TABLE limit_one_target(time timestamptz);
PREPARE limit_one_prep(int) AS SELECT time, val FROM limit_one_more ORDER BY time, val LIMIT $1;

-- batch sorted merge on two orderby columns, the first rows tie on time
EXPLAIN (costs off) SELECT time, device, val FROM limit_one_more ORDER BY time, val LIMIT 1;
SELECT time, device, val FROM limit_one_more ORDER BY time, val LIMIT 1;
-- toasted first/last values
EXPLAIN (costs off) SELECT device, length(txt), md5(txt) FROM limit_one_more ORDER BY time DESC, val DESC LIMIT 1;
SELECT device, length(txt), md5(txt) FROM limit_one_more ORDER BY time DESC, val DESC LIMIT 1;
-- rescan of a correlated subquery
EXPLAIN (costs off) SELECT d, (SELECT val FROM limit_one_more WHERE device = d ORDER BY time DESC LIMIT 1) FROM generate_series(1, 2) d;
SELECT d, (SELECT val FROM limit_one_more WHERE device = d ORDER BY time DESC LIMIT 1) FROM generate_series(1, 2) d;
-- UNION ALL arms with WHERE are planned separately, without the LIMIT
EXPLAIN (costs off) SELECT time, val FROM (SELECT time, val FROM limit_one_more WHERE device = 1 UNION ALL SELECT time, val FROM limit_one_more WHERE device = 2) s ORDER BY time, val LIMIT 1;
SELECT time, val FROM (SELECT time, val FROM limit_one_more WHERE device = 1 UNION ALL SELECT time, val FROM limit_one_more WHERE device = 2) s ORDER BY time, val LIMIT 1;
-- UNION ALL arms without WHERE are flattened
EXPLAIN (costs off) SELECT time FROM (SELECT time FROM limit_one_more UNION ALL SELECT time FROM limit_one_desc) s ORDER BY time LIMIT 1;
SELECT time FROM (SELECT time FROM limit_one_more UNION ALL SELECT time FROM limit_one_desc) s ORDER BY time LIMIT 1;
-- prepared statements use metadata only with a custom plan
SET plan_cache_mode = force_custom_plan;
EXPLAIN (costs off) EXECUTE limit_one_prep(1);
EXECUTE limit_one_prep(1);
SET plan_cache_mode = force_generic_plan;
EXPLAIN (costs off) EXECUTE limit_one_prep(1);
EXECUTE limit_one_prep(1);
RESET plan_cache_mode;
-- orderby DESC with min/max metadata, read forward and in reverse
EXPLAIN (costs off) SELECT time FROM limit_one_desc ORDER BY time DESC LIMIT 1;
SELECT time FROM limit_one_desc ORDER BY time DESC LIMIT 1;
EXPLAIN (costs off) SELECT time FROM limit_one_desc ORDER BY time LIMIT 1;
SELECT time FROM limit_one_desc ORDER BY time LIMIT 1;
-- metadata only scans do not count as decompression
SELECT n_selects, total_batches_decompressed, total_tuples_decompressed, compressed_batch_rows_min
FROM timescaledb_information.stat_chunk_activity WHERE hypertable = 'limit_one_more';
SELECT time, val FROM limit_one_more ORDER BY time, val LIMIT 1;
SELECT n_selects, total_batches_decompressed, total_tuples_decompressed, compressed_batch_rows_min
FROM timescaledb_information.stat_chunk_activity WHERE hypertable = 'limit_one_more';
-- subquery of a DELETE needs decompression
EXPLAIN (costs off) DELETE FROM limit_one_target WHERE time = (SELECT time FROM limit_one_more ORDER BY time, val LIMIT 1);

-- results match the decompressed scan
SET timescaledb.enable_columnarscan_metadata_only = off;
SELECT time, device, val FROM limit_one_more ORDER BY time, val LIMIT 1;
SELECT device, length(txt), md5(txt) FROM limit_one_more ORDER BY time DESC, val DESC LIMIT 1;
SELECT d, (SELECT val FROM limit_one_more WHERE device = d ORDER BY time DESC LIMIT 1) FROM generate_series(1, 2) d;
SELECT time, val FROM (SELECT time, val FROM limit_one_more WHERE device = 1 UNION ALL SELECT time, val FROM limit_one_more WHERE device = 2) s ORDER BY time, val LIMIT 1;
SELECT time FROM (SELECT time FROM limit_one_more UNION ALL SELECT time FROM limit_one_desc) s ORDER BY time LIMIT 1;
SELECT time FROM limit_one_desc ORDER BY time DESC LIMIT 1;
SELECT time FROM limit_one_desc ORDER BY time LIMIT 1;
RESET timescaledb.enable_columnarscan_metadata_only;

-- partial chunks need decompression
INSERT INTO limit_one_more VALUES ('2000-01-01 00:00:30', 1, 0, 'x');
EXPLAIN (costs off) SELECT time, val FROM limit_one_more ORDER BY time, val LIMIT 1;
SELECT time, val FROM limit_one_more ORDER BY time, val LIMIT 1;

DEALLOCATE limit_one_prep;
DROP TABLE limit_one_more;
DROP TABLE limit_one_desc;
DROP TABLE limit_one_target;

-- min/max on a chunk with many segments are answered from metadata
CREATE TABLE limit_one_minmax(time timestamptz NOT NULL, sensor_id int NOT NULL, temp float8);
SELECT table_name FROM create_hypertable('limit_one_minmax', 'time', chunk_time_interval => interval '365 days');
ALTER TABLE limit_one_minmax SET (timescaledb.compress, timescaledb.compress_orderby = 'time', timescaledb.compress_segmentby = 'sensor_id');
INSERT INTO limit_one_minmax SELECT '2024-01-01'::timestamptz + t * interval '1 second', s, t FROM generate_series(1, 10000) s, generate_series(0, 1) t;
SELECT count(compress_chunk(c)) FROM show_chunks('limit_one_minmax') c;
EXPLAIN (costs off) SELECT max(time) FROM limit_one_minmax;
SELECT max(time) FROM limit_one_minmax;
EXPLAIN (costs off) SELECT min(time), max(time) FROM limit_one_minmax;
SELECT min(time), max(time) FROM limit_one_minmax;
DROP TABLE limit_one_minmax;

-- LIMIT from a stable expression is not answered from metadata
CREATE TABLE limit_one_stable(time timestamptz NOT NULL, device int NOT NULL)
 WITH (tsdb.hypertable,tsdb.orderby='time',tsdb.segmentby='device',tsdb.chunk_interval='1 day');
INSERT INTO limit_one_stable SELECT '2000-01-01'::timestamptz + i * interval '1 minute', 1 FROM generate_series(1, 3000) i;
SELECT count(compress_chunk(ch)) FROM show_chunks('limit_one_stable') ch;
ANALYZE limit_one_stable;
SET my.lim = '1';
PREPARE limit_one_stable_prep AS SELECT time, device FROM limit_one_stable ORDER BY time LIMIT current_setting('my.lim')::int;
EXPLAIN (costs off) EXECUTE limit_one_stable_prep;
EXECUTE limit_one_stable_prep;
SET my.lim = '3';
EXECUTE limit_one_stable_prep;
RESET my.lim;
DEALLOCATE limit_one_stable_prep;
DROP TABLE limit_one_stable;

-- min/max of the orderby column is not combined with last row values in reverse
CREATE TABLE limit_one_equal(t int NOT NULL, x numeric NOT NULL, y int)
 WITH (tsdb.hypertable,tsdb.partition_column='t',tsdb.chunk_interval=1000,tsdb.orderby='x',tsdb.index='minmax(x),firstlast(y)');
INSERT INTO limit_one_equal VALUES (1, 1.0, 10), (1, 1.00, 20), (1, 0.5, 5);
SELECT count(compress_chunk(ch)) FROM show_chunks('limit_one_equal') ch;
EXPLAIN (costs off) SELECT x, y FROM limit_one_equal ORDER BY x DESC LIMIT 1;
SELECT x, y FROM limit_one_equal ORDER BY x DESC LIMIT 1;
EXPLAIN (costs off) SELECT x, y FROM limit_one_equal ORDER BY x LIMIT 1;
SELECT x, y FROM limit_one_equal ORDER BY x LIMIT 1;
EXPLAIN (costs off) SELECT x FROM limit_one_equal ORDER BY x DESC LIMIT 1;
SELECT x FROM limit_one_equal ORDER BY x DESC LIMIT 1;
DROP TABLE limit_one_equal;

-- EXPLAIN VERBOSE shows when a scan is answered from metadata
CREATE TABLE limit_one_verbose(time timestamptz NOT NULL, device int NOT NULL, val float)
 WITH (tsdb.hypertable,tsdb.orderby='time',tsdb.segmentby='device',tsdb.chunk_interval='1 year');
INSERT INTO limit_one_verbose SELECT '2000-01-01'::timestamptz + i * interval '1 minute', i % 2, i FROM generate_series(1, 3000) i;
SELECT count(compress_chunk(ch)) FROM show_chunks('limit_one_verbose') ch;
ANALYZE limit_one_verbose;
EXPLAIN (costs off, verbose) SELECT time, device FROM limit_one_verbose ORDER BY time LIMIT 1;
EXPLAIN (costs off, verbose) SELECT time, val FROM limit_one_verbose ORDER BY time LIMIT 1;
DROP TABLE limit_one_verbose;

-- ORDER BY a column that is not the leading orderby is answered by sorting batches on its min/max
CREATE TABLE limit_one_sorted(time timestamptz NOT NULL, sensor int NOT NULL, device int NOT NULL, val float, val2 float NOT NULL, val3 float)
 WITH (tsdb.hypertable,tsdb.orderby='sensor,time DESC',tsdb.segmentby='device',tsdb.index='minmax(val2),minmax(val3)',tsdb.chunk_interval='1 year');
INSERT INTO limit_one_sorted SELECT '2000-01-01'::timestamptz + t * interval '1 second', s, s % 2, t, t, t
FROM generate_series(1, 20) s, generate_series(0, 599) t;
SELECT count(compress_chunk(ch)) FROM show_chunks('limit_one_sorted') ch;
ANALYZE limit_one_sorted;
EXPLAIN (costs off) SELECT time FROM limit_one_sorted ORDER BY time DESC LIMIT 1;
SELECT time FROM limit_one_sorted ORDER BY time DESC LIMIT 1;
EXPLAIN (costs off) SELECT time, device FROM limit_one_sorted ORDER BY time LIMIT 1;
SELECT time, device FROM limit_one_sorted ORDER BY time LIMIT 1;
EXPLAIN (costs off) SELECT time FROM limit_one_sorted WHERE device = 1 ORDER BY time DESC LIMIT 1;
SELECT time FROM limit_one_sorted WHERE device = 1 ORDER BY time DESC LIMIT 1;
EXPLAIN (costs off) SELECT val2 FROM limit_one_sorted ORDER BY val2 DESC LIMIT 1;
SELECT val2 FROM limit_one_sorted ORDER BY val2 DESC LIMIT 1;
-- needs decompression
EXPLAIN (costs off) SELECT time, sensor FROM limit_one_sorted ORDER BY time DESC LIMIT 1;
EXPLAIN (costs off) SELECT time, val FROM limit_one_sorted ORDER BY time DESC LIMIT 1;
EXPLAIN (costs off) SELECT val3 FROM limit_one_sorted ORDER BY val3 DESC LIMIT 1;
EXPLAIN (costs off) SELECT time FROM limit_one_sorted ORDER BY time DESC, device LIMIT 1;
-- min/max aggregates through DeferredChunkAppend
SET timescaledb.enable_deferred_chunk_append = on;
EXPLAIN (analyze, costs off, timing off, summary off, buffers off) SELECT max(time) FROM limit_one_sorted;
SELECT min(time), max(time) FROM limit_one_sorted;
SET timescaledb.enable_columnarscan_metadata_only = off;
SELECT min(time), max(time) FROM limit_one_sorted;
RESET timescaledb.enable_columnarscan_metadata_only;
SET timescaledb.enable_deferred_chunk_append = off;
DROP TABLE limit_one_sorted;
