-- an integer time column needs an integer_now function for a retention policy, which a table that
-- is only being created cannot have yet, so the policy cannot be applied, the same as for
-- add_retention_policy
SELECT add_storage_policy('retain_int', 'fhr', 'ret_int', '{
    "partition_column": "ts", "chunk_interval": "1000", "retention": {"mode": "AFTER", "after": "100000"}
}');
 add_storage_policy 
--------------------
                 26

\set ON_ERROR_STOP 0
\set VERBOSITY default
CREATE TABLE fhr.ret_int (ts bigint NOT NULL, v int);
ERROR:  cannot apply storage policy "retain_int" to "fhr"."ret_int"
DETAIL:  invalid value for parameter drop_after
HINT:  Integer duration in "drop_after" with valid "integer_now" function or interval time duration in "drop_created_before" is required for hypertables with integer time dimension. Alternatively, create the table WITH (tsdb.hypertable = false) to skip storage policies.
\set VERBOSITY terse
\set ON_ERROR_STOP 1
SELECT count(*) FROM pg_class WHERE relname = 'ret_int';
