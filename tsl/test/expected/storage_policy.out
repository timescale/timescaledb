CREATE TABLE fhr.t4 (ts timestamptz NOT NULL);
NOTICE:  applied storage policy "guc" to "fhr"."t4"
SELECT count(*) FROM timescaledb_information.hypertables WHERE hypertable_name = 't4';
 count 
-------
     1

