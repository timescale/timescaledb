 remove_storage_policy 
-----------------------
 

SELECT remove_storage_policy('disabled');
 remove_storage_policy 
-----------------------
 

SELECT remove_storage_policy('notime');
 remove_storage_policy 
-----------------------
 

SELECT remove_storage_policy('badcol');
 remove_storage_policy 
-----------------------
 

SELECT remove_storage_policy('badseg');
 remove_storage_policy 
-----------------------
 

SELECT remove_storage_policy('badpk');
 remove_storage_policy 
