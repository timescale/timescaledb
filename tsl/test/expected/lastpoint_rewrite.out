\set TEST_BASE_NAME lastpoint_rewrite
SELECT format('include/%s_query.sql', :'TEST_BASE_NAME') AS "TEST_QUERY_NAME",
    format('%s/results/%s_results_unoptimized.out', :'TEST_OUTPUT_DIR', :'TEST_BASE_NAME') AS "TEST_RESULTS_UNOPTIMIZED",
    format('%s/results/%s_results_optimized.out', :'TEST_OUTPUT_DIR', :'TEST_BASE_NAME') AS "TEST_RESULTS_OPTIMIZED" \gset
SELECT format('\! diff -u --label "Unoptimized results" --label "Optimized results" %s %s', :'TEST_RESULTS_UNOPTIMIZED', :'TEST_RESULTS_OPTIMIZED') AS "DIFF_CMD" \gset
CREATE TABLE lastpoint(time timestamptz NOT NULL, device text NOT NULL, nullable_device text, v float8, tiebreak int)
WITH (tsdb.hypertable, tsdb.partition_column = 'time', tsdb.chunk_interval = '1 day',
    tsdb.segmentby = 'device', tsdb.orderby = 'time DESC');
INSERT INTO lastpoint
SELECT t, 'd' || d, CASE WHEN d % 7 = 0 THEN NULL ELSE 'd' || d END, (d * 37 + extract(epoch FROM t)::int / 3600 * 11) % 100, 1
FROM generate_series('2025-01-01'::timestamptz, '2025-01-05 23:00', '1 hour') t, generate_series(1, 20) d
WHERE d != 5 OR t < '2025-01-02';
-- Ties on time, broken by another column.
INSERT INTO lastpoint VALUES ('2025-01-05 23:00', 'd1', 'd1', 1000, 2), ('2025-01-05 23:00', 'd2', 'd2', -1000, 0);
SELECT count(compress_chunk(c)) FROM show_chunks('lastpoint', older_than => '2025-01-05'::timestamptz) c;
 count 
-------
     4

VACUUM ANALYZE lastpoint;
SET timescaledb.enable_lastpoint_rewrite TO on;
EXPLAIN (costs off, timing off, summary off)
SELECT DISTINCT ON (device) * FROM lastpoint ORDER BY device, time DESC;
--- QUERY PLAN ---
 Nested Loop
   ->  Sort
         Sort Key: lastpoint.device
         ->  HashAggregate
               Group Key: lastpoint.device
               ->  Append
                     ->  Custom Scan (ColumnarScan) on _hyper_1_1_chunk
                           ->  Seq Scan on _hyper_1_1_chunk_compressed
                     ->  Custom Scan (ColumnarScan) on _hyper_1_2_chunk
                           ->  Seq Scan on _hyper_1_2_chunk_compressed
                     ->  Custom Scan (ColumnarScan) on _hyper_1_3_chunk
                           ->  Seq Scan on _hyper_1_3_chunk_compressed
                     ->  Custom Scan (ColumnarScan) on _hyper_1_4_chunk
                           ->  Seq Scan on _hyper_1_4_chunk_compressed
                     ->  Seq Scan on _hyper_1_5_chunk
                     ->  Seq Scan on _hyper_1_6_chunk
   ->  Limit
         ->  Custom Scan (ChunkAppend) on lastpoint lastpoint_1
               Order: lastpoint_1."time" DESC
               ->  Index Scan using _hyper_1_6_chunk_lastpoint_time_idx on _hyper_1_6_chunk _hyper_1_6_chunk_1
                     Filter: (device = lastpoint.device)
               ->  Index Scan using _hyper_1_5_chunk_lastpoint_time_idx on _hyper_1_5_chunk _hyper_1_5_chunk_1
                     Filter: (device = lastpoint.device)
               ->  Custom Scan (ColumnarScan) on _hyper_1_4_chunk _hyper_1_4_chunk_1
                     ->  Sort
                           Sort Key: _hyper_1_4_chunk_compressed_1._ts_meta_v2_first_time DESC, _hyper_1_4_chunk_compressed_1._ts_meta_v2_last_time DESC
                           ->  Seq Scan on _hyper_1_4_chunk_compressed _hyper_1_4_chunk_compressed_1
                                 Filter: (device = lastpoint.device)
               ->  Custom Scan (ColumnarScan) on _hyper_1_3_chunk _hyper_1_3_chunk_1
                     ->  Sort
                           Sort Key: _hyper_1_3_chunk_compressed_1._ts_meta_v2_first_time DESC, _hyper_1_3_chunk_compressed_1._ts_meta_v2_last_time DESC
                           ->  Seq Scan on _hyper_1_3_chunk_compressed _hyper_1_3_chunk_compressed_1
                                 Filter: (device = lastpoint.device)
               ->  Custom Scan (ColumnarScan) on _hyper_1_2_chunk _hyper_1_2_chunk_1
                     ->  Sort
                           Sort Key: _hyper_1_2_chunk_compressed_1._ts_meta_v2_first_time DESC, _hyper_1_2_chunk_compressed_1._ts_meta_v2_last_time DESC
                           ->  Seq Scan on _hyper_1_2_chunk_compressed _hyper_1_2_chunk_compressed_1
                                 Filter: (device = lastpoint.device)
               ->  Custom Scan (ColumnarScan) on _hyper_1_1_chunk _hyper_1_1_chunk_1
                     ->  Sort
                           Sort Key: _hyper_1_1_chunk_compressed_1._ts_meta_v2_first_time DESC, _hyper_1_1_chunk_compressed_1._ts_meta_v2_last_time DESC
                           ->  Seq Scan on _hyper_1_1_chunk_compressed _hyper_1_1_chunk_compressed_1
                                 Filter: (device = lastpoint.device)

-- Not rewritten: nullable key, no time order, volatile functions.
EXPLAIN (costs off, timing off, summary off)
SELECT DISTINCT ON (nullable_device) * FROM lastpoint ORDER BY nullable_device, time DESC;
--- QUERY PLAN ---
 Unique
   ->  Merge Append
         Sort Key: lastpoint.nullable_device, lastpoint."time" DESC
         ->  Sort
               Sort Key: _hyper_1_1_chunk.nullable_device, _hyper_1_1_chunk."time" DESC
               ->  Custom Scan (ColumnarScan) on _hyper_1_1_chunk
                     ->  Seq Scan on _hyper_1_1_chunk_compressed
         ->  Sort
               Sort Key: _hyper_1_2_chunk.nullable_device, _hyper_1_2_chunk."time" DESC
               ->  Custom Scan (ColumnarScan) on _hyper_1_2_chunk
                     ->  Seq Scan on _hyper_1_2_chunk_compressed
         ->  Sort
               Sort Key: _hyper_1_3_chunk.nullable_device, _hyper_1_3_chunk."time" DESC
               ->  Custom Scan (ColumnarScan) on _hyper_1_3_chunk
                     ->  Seq Scan on _hyper_1_3_chunk_compressed
         ->  Sort
               Sort Key: _hyper_1_4_chunk.nullable_device, _hyper_1_4_chunk."time" DESC
               ->  Custom Scan (ColumnarScan) on _hyper_1_4_chunk
                     ->  Seq Scan on _hyper_1_4_chunk_compressed
         ->  Sort
               Sort Key: _hyper_1_5_chunk.nullable_device, _hyper_1_5_chunk."time" DESC
               ->  Seq Scan on _hyper_1_5_chunk
         ->  Sort
               Sort Key: _hyper_1_6_chunk.nullable_device, _hyper_1_6_chunk."time" DESC
               ->  Seq Scan on _hyper_1_6_chunk

EXPLAIN (costs off, timing off, summary off)
SELECT DISTINCT ON (device) * FROM lastpoint ORDER BY device, v DESC;
--- QUERY PLAN ---
 Unique
   ->  Merge Append
         Sort Key: lastpoint.device, lastpoint.v DESC
         ->  Sort
               Sort Key: _hyper_1_1_chunk.device, _hyper_1_1_chunk.v DESC
               ->  Custom Scan (ColumnarScan) on _hyper_1_1_chunk
                     ->  Seq Scan on _hyper_1_1_chunk_compressed
         ->  Sort
               Sort Key: _hyper_1_2_chunk.device, _hyper_1_2_chunk.v DESC
               ->  Custom Scan (ColumnarScan) on _hyper_1_2_chunk
                     ->  Seq Scan on _hyper_1_2_chunk_compressed
         ->  Sort
               Sort Key: _hyper_1_3_chunk.device, _hyper_1_3_chunk.v DESC
               ->  Custom Scan (ColumnarScan) on _hyper_1_3_chunk
                     ->  Seq Scan on _hyper_1_3_chunk_compressed
         ->  Sort
               Sort Key: _hyper_1_4_chunk.device, _hyper_1_4_chunk.v DESC
               ->  Custom Scan (ColumnarScan) on _hyper_1_4_chunk
                     ->  Seq Scan on _hyper_1_4_chunk_compressed
         ->  Sort
               Sort Key: _hyper_1_5_chunk.device, _hyper_1_5_chunk.v DESC
               ->  Seq Scan on _hyper_1_5_chunk
         ->  Sort
               Sort Key: _hyper_1_6_chunk.device, _hyper_1_6_chunk.v DESC
               ->  Seq Scan on _hyper_1_6_chunk

EXPLAIN (costs off, timing off, summary off)
SELECT DISTINCT ON (device) device, random() FROM lastpoint ORDER BY device, time DESC;
--- QUERY PLAN ---
 Result
   ->  Unique
         ->  Merge Append
               Sort Key: lastpoint.device, lastpoint."time" DESC
               ->  Custom Scan (SkipScan) on _hyper_1_1_chunk
                     ->  Custom Scan (ColumnarScan) on _hyper_1_1_chunk
                           ->  Index Scan using _hyper_1_1_chunk_compressed_device__ts_meta_v2_first_time___idx on _hyper_1_1_chunk_compressed
               ->  Custom Scan (SkipScan) on _hyper_1_2_chunk
                     ->  Custom Scan (ColumnarScan) on _hyper_1_2_chunk
                           ->  Index Scan using _hyper_1_2_chunk_compressed_device__ts_meta_v2_first_time___idx on _hyper_1_2_chunk_compressed
               ->  Custom Scan (SkipScan) on _hyper_1_3_chunk
                     ->  Custom Scan (ColumnarScan) on _hyper_1_3_chunk
                           ->  Index Scan using _hyper_1_3_chunk_compressed_device__ts_meta_v2_first_time___idx on _hyper_1_3_chunk_compressed
               ->  Custom Scan (SkipScan) on _hyper_1_4_chunk
                     ->  Custom Scan (ColumnarScan) on _hyper_1_4_chunk
                           ->  Index Scan using _hyper_1_4_chunk_compressed_device__ts_meta_v2_first_time___idx on _hyper_1_4_chunk_compressed
               ->  Sort
                     Sort Key: _hyper_1_5_chunk.device, _hyper_1_5_chunk."time" DESC
                     ->  Seq Scan on _hyper_1_5_chunk
               ->  Sort
                     Sort Key: _hyper_1_6_chunk.device, _hyper_1_6_chunk."time" DESC
                     ->  Seq Scan on _hyper_1_6_chunk

\o :TEST_RESULTS_OPTIMIZED
\ir :TEST_QUERY_NAME
-- This file and its contents are licensed under the Timescale License.
-- Please see the included NOTICE for copyright information and
-- LICENSE-TIMESCALE for a copy of the license.
SELECT DISTINCT ON (device) * FROM lastpoint ORDER BY device, time DESC, tiebreak DESC;
SELECT DISTINCT ON (device) device, time, v FROM lastpoint WHERE time < '2025-01-03' ORDER BY device, time DESC, tiebreak;
SELECT DISTINCT ON (device) time, v * 2 AS v2 FROM lastpoint ORDER BY device, time DESC, tiebreak LIMIT 5 OFFSET 2;
SELECT DISTINCT ON (device) * FROM lastpoint ORDER BY device DESC, time DESC, tiebreak;
SELECT DISTINCT ON (device) * FROM lastpoint WHERE v > 50 ORDER BY device, time, tiebreak;
SELECT DISTINCT ON (device) device, time FROM lastpoint WHERE device > 'd15' ORDER BY device, time DESC;
SELECT DISTINCT ON (nullable_device) nullable_device, time, v FROM lastpoint ORDER BY nullable_device, time DESC, tiebreak;
SELECT DISTINCT ON (nullable_device) nullable_device, time, v FROM lastpoint ORDER BY nullable_device NULLS FIRST, time DESC, tiebreak;
\o
SET timescaledb.enable_lastpoint_rewrite TO off;
\o :TEST_RESULTS_UNOPTIMIZED
\ir :TEST_QUERY_NAME
-- This file and its contents are licensed under the Timescale License.
-- Please see the included NOTICE for copyright information and
-- LICENSE-TIMESCALE for a copy of the license.
SELECT DISTINCT ON (device) * FROM lastpoint ORDER BY device, time DESC, tiebreak DESC;
SELECT DISTINCT ON (device) device, time, v FROM lastpoint WHERE time < '2025-01-03' ORDER BY device, time DESC, tiebreak;
SELECT DISTINCT ON (device) time, v * 2 AS v2 FROM lastpoint ORDER BY device, time DESC, tiebreak LIMIT 5 OFFSET 2;
SELECT DISTINCT ON (device) * FROM lastpoint ORDER BY device DESC, time DESC, tiebreak;
SELECT DISTINCT ON (device) * FROM lastpoint WHERE v > 50 ORDER BY device, time, tiebreak;
SELECT DISTINCT ON (device) device, time FROM lastpoint WHERE device > 'd15' ORDER BY device, time DESC;
SELECT DISTINCT ON (nullable_device) nullable_device, time, v FROM lastpoint ORDER BY nullable_device, time DESC, tiebreak;
SELECT DISTINCT ON (nullable_device) nullable_device, time, v FROM lastpoint ORDER BY nullable_device NULLS FIRST, time DESC, tiebreak;
\o
:DIFF_CMD
DROP TABLE lastpoint;
