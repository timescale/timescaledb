EXPLAIN (costs off) SELECT time FROM limit_one WHERE val > 1000 ORDER BY time LIMIT 1;
--- QUERY PLAN ---
 Limit
   ->  Custom Scan (ChunkAppend) on limit_one
         Order: limit_one."time"
         ->  Custom Scan (ColumnarScan) on _hyper_1_1_chunk
               Filter: (val > '1000'::double precision)
               ->  Sort
                     Sort Key: _hyper_1_1_chunk_compressed._ts_meta_v2_first_time
                     ->  Seq Scan on _hyper_1_1_chunk_compressed
         ->  Custom Scan (ColumnarScan) on _hyper_1_2_chunk
               Filter: (val > '1000'::double precision)
               ->  Sort
                     Sort Key: _hyper_1_2_chunk_compressed._ts_meta_v2_first_time
                     ->  Seq Scan on _hyper_1_2_chunk_compressed
         ->  Custom Scan (ColumnarScan) on _hyper_1_3_chunk
               Filter: (val > '1000'::double precision)
               ->  Sort
                     Sort Key: _hyper_1_3_chunk_compressed._ts_meta_v2_first_time
                     ->  Seq Scan on _hyper_1_3_chunk_compressed

EXPLAIN (costs off) SELECT l1.time FROM limit_one l1, limit_one l2 WHERE l1.time = l2.ts2 ORDER BY l1.time LIMIT 1;
--- QUERY PLAN ---
 Limit
   ->  Nested Loop
         Join Filter: (l1."time" = l2.ts2)
         ->  Custom Scan (ChunkAppend) on limit_one l1
               Order: l1."time"
               ->  Custom Scan (ColumnarScan) on _hyper_1_1_chunk l1_1
                     ->  Sort
                           Sort Key: _hyper_1_1_chunk_compressed._ts_meta_v2_first_time
                           ->  Seq Scan on _hyper_1_1_chunk_compressed
               ->  Custom Scan (ColumnarScan) on _hyper_1_2_chunk l1_2
                     ->  Sort
                           Sort Key: _hyper_1_2_chunk_compressed._ts_meta_v2_first_time
                           ->  Seq Scan on _hyper_1_2_chunk_compressed
               ->  Custom Scan (ColumnarScan) on _hyper_1_3_chunk l1_3
                     ->  Sort
                           Sort Key: _hyper_1_3_chunk_compressed._ts_meta_v2_first_time
                           ->  Seq Scan on _hyper_1_3_chunk_compressed
         ->  Materialize
               ->  Append
                     ->  Custom Scan (ColumnarScan) on _hyper_1_1_chunk l2_1
                           ->  Seq Scan on _hyper_1_1_chunk_compressed _hyper_1_1_chunk_compressed_1
                     ->  Custom Scan (ColumnarScan) on _hyper_1_2_chunk l2_2
                           ->  Seq Scan on _hyper_1_2_chunk_compressed _hyper_1_2_chunk_compressed_1
                     ->  Custom Scan (ColumnarScan) on _hyper_1_3_chunk l2_3
                           ->  Seq Scan on _hyper_1_3_chunk_compressed _hyper_1_3_chunk_compressed_1

EXPLAIN (costs off) SELECT time FROM limit_one_minmax_null ORDER BY time DESC LIMIT 1;
--- QUERY PLAN ---
 Limit
   ->  Sort
         Sort Key: _hyper_3_5_chunk."time" DESC
         ->  Custom Scan (ColumnarScan) on _hyper_3_5_chunk
               ->  Seq Scan on _hyper_3_5_chunk_compressed

SELECT time FROM limit_one_minmax_null ORDER BY time DESC LIMIT 1;
