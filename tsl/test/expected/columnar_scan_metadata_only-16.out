   ->  Result
         ->  Custom Scan (ChunkAppend) on limit_one
               Order: limit_one."time"
               ->  Custom Scan (ColumnarScan) on _hyper_1_1_chunk
                     ->  Sort
                           Sort Key: _hyper_1_1_chunk_compressed._ts_meta_v2_first_time, _hyper_1_1_chunk_compressed._ts_meta_v2_last_time
                           ->  Seq Scan on _hyper_1_1_chunk_compressed
                                 Filter: (device = 2)
               ->  Custom Scan (ColumnarScan) on _hyper_1_2_chunk
                     ->  Sort
                           Sort Key: _hyper_1_2_chunk_compressed._ts_meta_v2_first_time, _hyper_1_2_chunk_compressed._ts_meta_v2_last_time
                           ->  Seq Scan on _hyper_1_2_chunk_compressed
                                 Filter: (device = 2)
               ->  Custom Scan (ColumnarScan) on _hyper_1_3_chunk
                     ->  Sort
                           Sort Key: _hyper_1_3_chunk_compressed._ts_meta_v2_first_time, _hyper_1_3_chunk_compressed._ts_meta_v2_last_time
                           ->  Seq Scan on _hyper_1_3_chunk_compressed
                                 Filter: (device = 2)

