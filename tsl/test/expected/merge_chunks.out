 _timescaledb_internal._hyper_1_4_chunk            |            1 |               0
 _timescaledb_internal._hyper_1_5_chunk            |            1 |               0
 _timescaledb_internal._hyper_1_9_chunk            |            1 |               0
 _timescaledb_internal._hyper_3_14_chunk           |            3 |               1
 _timescaledb_internal._hyper_3_15_chunk           |            3 |               1

set role :ROLE_DEFAULT_PERM_USER;
-- Save non-cleaned information
create table pre_cleaned_chunks as select * from _timescaledb_catalog.chunk_rewrite;
-- Should only clean up its own failed merges
call _timescaledb_functions.chunk_rewrite_cleanup();
NOTICE:  cleaned up 5 orphaned rewrite relations, skipped 2
select * from chunks_being_merged;
               chunk_relid               | new_chunk_id | num_new_indexes 
-----------------------------------------+--------------+-----------------
 _timescaledb_internal._hyper_3_14_chunk |            1 |               1
 _timescaledb_internal._hyper_3_15_chunk |            1 |               1

set role :ROLE_1;
call _timescaledb_functions.chunk_rewrite_cleanup();
NOTICE:  cleaned up 2 orphaned rewrite relations, skipped 0
-- Everything cleaned up
select * from chunks_being_merged;
 chunk_relid | new_chunk_id | num_new_indexes 
-------------+--------------+-----------------

set role :ROLE_DEFAULT_PERM_USER;
-- None of the pre-cleaned chunks should remain after cleanup. Check by joining
-- the pre-cleaned relids with pg_class. The count of the join should be zero if the
-- relations no longer exist in pg_class.
select count(*) from pre_cleaned_chunks;
 count 
-------
     7

select count(*) from pre_cleaned_chunks cc join pg_class c on (c.oid = cc.new_relid);
 count 
-------
     0

-- Fail merges again to test superuser cleanup
\set ON_ERROR_STOP 0
call merge_chunks_concurrently(ARRAY['_timescaledb_internal._hyper_1_1_chunk', '_timescaledb_internal._hyper_1_4_chunk','_timescaledb_internal._hyper_1_5_chunk', '_timescaledb_internal._hyper_1_9_chunk']);
ERROR:  error injected at debug point 'merge_chunks_fail'
set role :ROLE_1;
call merge_chunks(:'role1_chunk1', :'role1_chunk2', concurrently => true);
ERROR:  error injected at debug point 'merge_chunks_fail'
\set ON_ERROR_STOP 1
set role :ROLE_DEFAULT_PERM_USER;
select debug_waitpoint_release('merge_chunks_fail');
 debug_waitpoint_release 
-------------------------
 

select * from chunks_being_merged;
                    chunk_relid                    | new_chunk_id | num_new_indexes 
---------------------------------------------------+--------------+-----------------
 _timescaledb_internal._hyper_1_1_chunk            |            1 |               2
 _timescaledb_internal._hyper_1_1_chunk_compressed |            2 |               1
 _timescaledb_internal._hyper_1_4_chunk            |            1 |               2
 _timescaledb_internal._hyper_1_5_chunk            |            1 |               2
 _timescaledb_internal._hyper_1_9_chunk            |            1 |               2
 _timescaledb_internal._hyper_3_14_chunk           |            3 |               1
 _timescaledb_internal._hyper_3_15_chunk           |            3 |               1

-- Reset to superuser
reset role;
select current_user;
 current_user 
--------------
 super_user

call _timescaledb_functions.chunk_rewrite_cleanup();
NOTICE:  cleaned up 7 orphaned rewrite relations, skipped 0
select * from chunks_being_merged;
 chunk_relid | new_chunk_id | num_new_indexes 
-------------+--------------+-----------------

drop table pre_cleaned_chunks;
-- Test successful merges in concurrent mode
call merge_chunks('_timescaledb_internal._hyper_1_1_chunk', '_timescaledb_internal._hyper_1_4_chunk', concurrently => true);
call merge_chunks_concurrently(ARRAY['_timescaledb_internal._hyper_1_1_chunk', '_timescaledb_internal._hyper_1_5_chunk', '_timescaledb_internal._hyper_1_9_chunk']);
drop view chunks_being_merged;
-- Test: Verify merged chunks remain in publication
\c :TEST_DBNAME :ROLE_SUPERUSER
SET timescaledb.enable_chunk_auto_publication = true;
CREATE TABLE pub_merge_test(time timestamptz not null, device int, temp float);
SELECT create_hypertable('pub_merge_test', 'time', chunk_time_interval => interval '1 day');
      create_hypertable      
-----------------------------
 (4,public,pub_merge_test,t)

-- Insert data to create multiple chunks
INSERT INTO pub_merge_test VALUES
    ('2024-01-01 01:00', 1, 1.0),
    ('2024-01-02 01:00', 2, 2.0);
-- Create publication
-- This suite runs at wal_level = replica, so hide the warning about that
SET client_min_messages TO error;
CREATE PUBLICATION test_merge_pub FOR TABLE pub_merge_test;
RESET client_min_messages;
-- Verify chunks before merge
SELECT schemaname, tablename
FROM pg_publication_tables
WHERE pubname = 'test_merge_pub'
ORDER BY schemaname, tablename;
      schemaname       |     tablename     
-----------------------+-------------------
 _timescaledb_internal | _hyper_4_16_chunk
 _timescaledb_internal | _hyper_4_17_chunk
 public                | pub_merge_test

-- Merge chunks
SELECT show_chunks('pub_merge_test') as chunk1 ORDER BY 1 LIMIT 1 OFFSET 0 \gset
SELECT show_chunks('pub_merge_test') as chunk2 ORDER BY 1 LIMIT 1 OFFSET 1 \gset
CALL merge_chunks(:'chunk1', :'chunk2');
-- Verify merged chunk remains in publication
SELECT schemaname, tablename
FROM pg_publication_tables
WHERE pubname = 'test_merge_pub'
ORDER BY schemaname, tablename;
      schemaname       |     tablename     
-----------------------+-------------------
 _timescaledb_internal | _hyper_4_16_chunk
 public                | pub_merge_test

-- Cleanup
DROP PUBLICATION test_merge_pub CASCADE;
DROP TABLE pub_merge_test CASCADE;
-- Test merging chunks compressed with different compression settings.
\c :TEST_DBNAME :ROLE_DEFAULT_PERM_USER
CREATE TABLE compress_settings_merge(
    time   timestamptz NOT NULL,
    device int,
    name   text,
    temp   float8,
    val    int
);
SELECT create_hypertable('compress_settings_merge', 'time', chunk_time_interval => INTERVAL '1 day');
          create_hypertable           
--------------------------------------
 (5,public,compress_settings_merge,t)

INSERT INTO compress_settings_merge VALUES
    ('2024-01-01 12:00', 1, 'one', 1.5, 100),
    ('2024-01-02 12:00', 2, 'two', 2.5, 200);
SELECT relid::text AS first_chunk
FROM _timescaledb_catalog.chunk
WHERE hypertable_id = (SELECT id FROM _timescaledb_catalog.hypertable WHERE table_name='compress_settings_merge')
ORDER BY id LIMIT 1 \gset
SELECT relid::text AS second_chunk
FROM _timescaledb_catalog.chunk
WHERE hypertable_id = (SELECT id FROM _timescaledb_catalog.hypertable WHERE table_name='compress_settings_merge')
ORDER BY id OFFSET 1 LIMIT 1 \gset
-- Variant 1: change compress_segmentby between compressions.
BEGIN;
ALTER TABLE compress_settings_merge SET (timescaledb.compress, timescaledb.compress_segmentby='device');
SELECT compress_chunk(:'first_chunk');
             compress_chunk              
-----------------------------------------
 _timescaledb_internal._hyper_5_18_chunk

ALTER TABLE compress_settings_merge SET (timescaledb.compress, timescaledb.compress_segmentby='name');
NOTICE:  updated compression settings will only apply to future compressions
SELECT compress_chunk(:'second_chunk');
             compress_chunk              
-----------------------------------------
 _timescaledb_internal._hyper_5_19_chunk

\set ON_ERROR_STOP 0
CALL merge_chunks(ARRAY[:'first_chunk', :'second_chunk']::regclass[]);
ERROR:  cannot merge compressed chunks with different compression settings
SELECT * FROM compress_settings_merge ORDER BY time;
ERROR:  current transaction is aborted, commands ignored until end of transaction block
\set ON_ERROR_STOP 1
ROLLBACK;
-- Variant 2: change compress_orderby between compressions.
BEGIN;
ALTER TABLE compress_settings_merge SET (timescaledb.compress, timescaledb.compress_segmentby='device', timescaledb.compress_orderby='time');
SELECT compress_chunk(:'first_chunk');
             compress_chunk              
-----------------------------------------
 _timescaledb_internal._hyper_5_18_chunk

ALTER TABLE compress_settings_merge SET (timescaledb.compress, timescaledb.compress_segmentby='device', timescaledb.compress_orderby='val DESC');
NOTICE:  updated compression settings will only apply to future compressions
SELECT compress_chunk(:'second_chunk');
             compress_chunk              
-----------------------------------------
 _timescaledb_internal._hyper_5_19_chunk

\set ON_ERROR_STOP 0
CALL merge_chunks(ARRAY[:'first_chunk', :'second_chunk']::regclass[]);
ERROR:  cannot merge compressed chunks with different compression settings
SELECT * FROM compress_settings_merge ORDER BY time;
ERROR:  current transaction is aborted, commands ignored until end of transaction block
\set ON_ERROR_STOP 1
ROLLBACK;
DROP TABLE compress_settings_merge;
-- Concurrent merge of compressed chunks: chunk_rewrite cleanup must not drop
-- the new compressed transient heap when cascading through non-result chunks.
\c :TEST_DBNAME :ROLE_DEFAULT_PERM_USER
CREATE TABLE concurrent_compressed_merge(
    time timestamptz NOT NULL, device int, temp float8
);
SELECT create_hypertable('concurrent_compressed_merge', 'time',
                         chunk_time_interval => INTERVAL '1 day');
            create_hypertable             
------------------------------------------
 (6,public,concurrent_compressed_merge,t)

ALTER TABLE concurrent_compressed_merge
    SET (timescaledb.compress, timescaledb.compress_segmentby='device');
INSERT INTO concurrent_compressed_merge VALUES
    ('2024-01-01 12:00', 1, 1.5),
    ('2024-01-02 12:00', 2, 2.5);
SELECT compress_chunk(ch) FROM show_chunks('concurrent_compressed_merge') ch;
             compress_chunk              
-----------------------------------------
 _timescaledb_internal._hyper_6_20_chunk
 _timescaledb_internal._hyper_6_21_chunk

SELECT relid::text AS ccm_c1
  FROM _timescaledb_catalog.chunk
 WHERE hypertable_id = (SELECT id FROM _timescaledb_catalog.hypertable WHERE table_name='concurrent_compressed_merge')
 ORDER BY id LIMIT 1 \gset
SELECT relid::text AS ccm_c2
  FROM _timescaledb_catalog.chunk
 WHERE hypertable_id = (SELECT id FROM _timescaledb_catalog.hypertable WHERE table_name='concurrent_compressed_merge')
 ORDER BY id OFFSET 1 LIMIT 1 \gset
CALL merge_chunks(:'ccm_c1'::regclass, :'ccm_c2'::regclass, concurrently => true);
SELECT count(*) AS rows_after, count(DISTINCT show_chunks) AS chunks_after
FROM concurrent_compressed_merge,
     show_chunks('concurrent_compressed_merge');
 rows_after | chunks_after 
------------+--------------
          2 |            1

DROP TABLE concurrent_compressed_merge;
-- Test merging compressed chunks whose sparse indexes are logically the same
-- but the JSONB entries mismatch
CREATE TABLE merge_sparse_order(
    time timestamptz NOT NULL,
    device int,
    temp float8,
    val int
);
SELECT create_hypertable('merge_sparse_order', 'time', chunk_time_interval => INTERVAL '1 day');
        create_hypertable        
---------------------------------
 (7,public,merge_sparse_order,t)

INSERT INTO merge_sparse_order
SELECT t, (i % 10) + 1, random() * 100, (i * 7) % 13
FROM generate_series('2024-01-01 2:00'::timestamptz, '2024-01-01 23:59', '1 minute') t,
     generate_series(1, 5) i;
INSERT INTO merge_sparse_order
SELECT t, (i % 10) + 1, random() * 100, (i * 7) % 13
FROM generate_series('2024-01-02 2:00'::timestamptz, '2024-01-02 23:59', '1 minute') t,
     generate_series(1, 5) i;
SELECT relid::text AS mso_c1
  FROM _timescaledb_catalog.chunk
 WHERE hypertable_id = (SELECT id FROM _timescaledb_catalog.hypertable
                         WHERE table_name = 'merge_sparse_order')
 ORDER BY id LIMIT 1 \gset
SELECT relid::text AS mso_c2
  FROM _timescaledb_catalog.chunk
 WHERE hypertable_id = (SELECT id FROM _timescaledb_catalog.hypertable
                         WHERE table_name = 'merge_sparse_order')
 ORDER BY id OFFSET 1 LIMIT 1 \gset
ALTER TABLE merge_sparse_order SET (
    timescaledb.compress,
    timescaledb.compress_orderby = 'time',
    timescaledb.compress_index = 'bloom("device"), minmax("temp"), bloom("device","val")'
);
SELECT compress_chunk(:'mso_c1');
             compress_chunk              
-----------------------------------------
 _timescaledb_internal._hyper_7_22_chunk

ALTER TABLE merge_sparse_order SET (
    timescaledb.compress,
    timescaledb.compress_orderby = 'time',
    timescaledb.compress_index = 'minmax("temp"), bloom("device")'
);
NOTICE:  updated compression settings will only apply to future compressions
