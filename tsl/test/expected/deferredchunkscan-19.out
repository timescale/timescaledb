-- a modifying CTE can't sit in a sub-select, so run it at top level
WITH w AS (INSERT INTO metrics_regular VALUES (now(), 1) RETURNING x)
SELECT time FROM metrics ORDER BY time LIMIT 1;  -- modifying CTE
             time             
------------------------------
 Wed Jan 01 00:00:00 2020 PST

RESET timescaledb.debug_require_deferred_chunk_scan;
-- RLS attaches to the hypertable, not its chunks, so the node must stay off to
-- avoid bypassing the policy with a direct chunk scan. RLS is not allowed on a
-- columnstore hypertable, so build a plain one.
CREATE TABLE metrics_rls (time timestamptz NOT NULL, device int, value float8)
  WITH (tsdb.hypertable, tsdb.partition_column = 'time', tsdb.chunk_interval = '1 day',
        tsdb.columnstore = false);
INSERT INTO metrics_rls
SELECT '2020-01-01'::timestamptz + d * interval '1 day', s, s * 10
FROM generate_series(0, 4) d, generate_series(0, 3) s;
ALTER TABLE metrics_rls ENABLE ROW LEVEL SECURITY;
ALTER TABLE metrics_rls FORCE ROW LEVEL SECURITY; -- apply the policy to the owner too
CREATE POLICY device_one ON metrics_rls FOR SELECT USING (device = 1);
SET timescaledb.debug_require_deferred_chunk_scan TO 'forbid';
-- the node must stay off; the policy must filter to device = 1 (no leaked rows)
SELECT count(*) AS visible, count(*) FILTER (WHERE device <> 1) AS leaked
FROM (SELECT device FROM metrics_rls LIMIT 100) x;
 visible | leaked 
---------+--------
       5 |      0

RESET timescaledb.debug_require_deferred_chunk_scan;
-- Column privileges: the node scans chunks directly, so per-column SELECT grants
-- on the hypertable must still be enforced.
CREATE TABLE metrics_colpriv (time timestamptz NOT NULL, device int, value float8)
  WITH (tsdb.hypertable, tsdb.partition_column = 'time', tsdb.chunk_interval = '1 day',
        tsdb.columnstore = false);
INSERT INTO metrics_colpriv
SELECT '2020-01-01'::timestamptz + d * interval '1 day', s, s * 10
FROM generate_series(0, 4) d, generate_series(0, 3) s;
GRANT SELECT (time, device) ON metrics_colpriv TO :ROLE_DEFAULT_PERM_USER_2;
-- reconnect as the grantee (resets session GUCs, so set them again)
\c :TEST_DBNAME :ROLE_DEFAULT_PERM_USER_2
SET timescaledb.enable_deferred_chunk_scan TO on;
-- granted columns: the node is used and returns rows
SET timescaledb.debug_require_deferred_chunk_scan TO 'require';
SELECT count(x) >= 0 AS ok FROM (SELECT device FROM metrics_colpriv ORDER BY time LIMIT 5) x;
 ok 
----
 t

RESET timescaledb.debug_require_deferred_chunk_scan;
-- ungranted column: denied at the hypertable before the node runs
\set ON_ERROR_STOP 0
SELECT value FROM metrics_colpriv ORDER BY time LIMIT 1;
ERROR:  permission denied for table metrics_colpriv
\set ON_ERROR_STOP 1
-- back to the owning user for the remaining queries
\c :TEST_DBNAME :ROLE_DEFAULT_PERM_USER
SET timescaledb.enable_deferred_chunk_scan TO on;
-- Views: a view checks base-table access as its owner (checkAsUser on the
-- underlying RTE), but the per-chunk query runs as the current user. The node
-- must stay off so the normal plan enforces the view owner's permissions.
CREATE VIEW metrics_view AS SELECT * FROM metrics;
GRANT SELECT ON metrics_view TO :ROLE_DEFAULT_PERM_USER_2;
-- a security_barrier view is not pulled up, so the node never sees a plain
-- hypertable reference and must stay off there too
CREATE VIEW metrics_barrier WITH (security_barrier) AS SELECT * FROM metrics;
GRANT SELECT ON metrics_barrier TO :ROLE_DEFAULT_PERM_USER_2;
\c :TEST_DBNAME :ROLE_DEFAULT_PERM_USER_2
SET timescaledb.enable_deferred_chunk_scan TO on;
SET timescaledb.debug_require_deferred_chunk_scan TO 'forbid';
-- reads through the views succeed without any direct grant on the hypertable
SELECT count(*) = 5 AS ok FROM (SELECT device FROM metrics_view ORDER BY time LIMIT 5) x;
 ok 
----
 t

SELECT count(*) = 5 AS ok FROM (SELECT device FROM metrics_barrier ORDER BY time LIMIT 5) x;
 ok 
----
 t

RESET timescaledb.debug_require_deferred_chunk_scan;
\c :TEST_DBNAME :ROLE_DEFAULT_PERM_USER
SET timescaledb.enable_deferred_chunk_scan TO on;
-- the view owner querying their own view: checkAsUser matches the current user,
-- so the node is safe to use
SET timescaledb.debug_require_deferred_chunk_scan TO 'require';
SELECT count(x) >= 0 AS ok FROM (SELECT device FROM metrics_view ORDER BY time LIMIT 5) x;
 ok 
----
 t

RESET timescaledb.debug_require_deferred_chunk_scan;
-- Feature off: node is never chosen, even for an accepted shape.
SET timescaledb.enable_deferred_chunk_scan TO off;
SET timescaledb.debug_require_deferred_chunk_scan TO 'forbid';
SELECT count(x) >= 0 AS ok FROM (SELECT * FROM metrics ORDER BY time LIMIT 1) x;
 ok 
----
 t

RESET timescaledb.debug_require_deferred_chunk_scan;
SET timescaledb.enable_deferred_chunk_scan TO on;
EXPLAIN (COSTS OFF) SELECT time FROM metrics ORDER BY time LIMIT 3;
--- QUERY PLAN ---
 Limit
   ->  Custom Scan (DeferredChunkScan) on metrics
         Order: "time"

EXPLAIN (COSTS OFF) SELECT time FROM metrics ORDER BY time DESC LIMIT 3;
--- QUERY PLAN ---
 Limit
   ->  Custom Scan (DeferredChunkScan) on metrics
         Order: "time" DESC

EXPLAIN (COSTS OFF) SELECT * FROM metrics LIMIT 1;
--- QUERY PLAN ---
 Limit
   ->  Custom Scan (DeferredChunkScan) on metrics

EXPLAIN (COSTS OFF) SELECT * FROM metrics WHERE device = 1 AND value > 5 ORDER BY time LIMIT 3;
--- QUERY PLAN ---
 Limit
   ->  Custom Scan (DeferredChunkScan) on metrics
         Order: "time"
         Filter: ((value > '5'::double precision)) AND ((device = 1))

EXPLAIN (COSTS OFF) SELECT min(time) FROM metrics;  -- min/max rewrite served by the node
--- QUERY PLAN ---
 Result
   InitPlan minmax_1
     ->  Limit
           ->  Custom Scan (DeferredChunkScan) on metrics
                 Order: "time"
                 Filter: (("time" IS NOT NULL))

EXPLAIN (COSTS OFF) SELECT time, device FROM metrics_ord ORDER BY time, device DESC LIMIT 3;  -- multi-key Order property
--- QUERY PLAN ---
 Limit
   ->  Custom Scan (DeferredChunkScan) on metrics_ord
         Order: "time", device DESC

EXPLAIN (COSTS OFF) SELECT time, grp FROM metrics_ord ORDER BY time DESC, grp USING ~<~ NULLS LAST LIMIT 3;  -- USING operator in Order property
--- QUERY PLAN ---
 Limit
   ->  Custom Scan (DeferredChunkScan) on metrics_ord
         Order: "time" DESC, grp USING OPERATOR(pg_catalog.~<~) NULLS LAST

-- Deparsed names must be schema-qualified, not left bare.
CREATE FUNCTION dcs_nonneg(int) RETURNS boolean LANGUAGE plpgsql STABLE AS 'BEGIN RETURN $1 >= 0; END';
CREATE FUNCTION dcs_eq(int, int) RETURNS boolean LANGUAGE plpgsql STABLE AS 'BEGIN RETURN $1 = $2; END';
CREATE OPERATOR === (LEFTARG = int, RIGHTARG = int, FUNCTION = dcs_eq);
SET timescaledb.debug_require_deferred_chunk_scan TO 'require';
EXPLAIN (COSTS OFF) SELECT time FROM metrics WHERE dcs_nonneg(device) ORDER BY time LIMIT 3;  -- function schema-qualified
--- QUERY PLAN ---
 Limit
   ->  Custom Scan (DeferredChunkScan) on metrics
         Order: "time"
         Filter: (public.dcs_nonneg(device))

EXPLAIN (COSTS OFF) SELECT time FROM metrics WHERE device === 1 ORDER BY time LIMIT 3;  -- operator schema-qualified
--- QUERY PLAN ---
 Limit
   ->  Custom Scan (DeferredChunkScan) on metrics
         Order: "time"
         Filter: ((device OPERATOR(public.===) 1))

SELECT count(x) >= 0 AS ok FROM (SELECT time FROM metrics WHERE dcs_nonneg(device) AND device === 1 ORDER BY time LIMIT 100) x;  -- qualified names resolve at execution
 ok 
----
 t

RESET timescaledb.debug_require_deferred_chunk_scan;
-- a mid-query search_path change must not swap in a shadowing function and bypass the filter.
\c :TEST_DBNAME :ROLE_SUPERUSER
SET timescaledb.enable_deferred_chunk_scan TO on;
CREATE SCHEMA dcs_trusted;
CREATE SCHEMA dcs_attacker;
CREATE FUNCTION dcs_trusted.allow(int) RETURNS boolean LANGUAGE plpgsql STABLE AS $$ BEGIN PERFORM set_config('search_path', 'dcs_attacker, public', false); RETURN $1 = 1; END $$;
CREATE FUNCTION dcs_attacker.allow(int) RETURNS boolean LANGUAGE plpgsql STABLE AS $$ BEGIN RETURN true; END $$;
CREATE TABLE dcs_flip (time timestamptz NOT NULL, device int)
  WITH (tsdb.hypertable, tsdb.partition_column = 'time', tsdb.chunk_interval = '1 day');
INSERT INTO dcs_flip SELECT '2020-01-01'::timestamptz + d * interval '1 day', g FROM generate_series(0, 4) d, generate_series(1, 3) g;
SET search_path TO dcs_trusted, public;
SET timescaledb.debug_require_deferred_chunk_scan TO 'require';
SELECT count(*) AS returned, count(*) FILTER (WHERE device <> 1) AS leaked FROM (SELECT device FROM dcs_flip WHERE allow(device) LIMIT 1000) x;  -- leaked must be 0
 returned | leaked 
----------+--------
        5 |      0

RESET timescaledb.debug_require_deferred_chunk_scan;
RESET search_path;
-- A noncontiguous OSM (tiered) chunk must disqualify the node.
CREATE EXTENSION postgres_fdw;
CREATE SERVER dcs_osm_fdw FOREIGN DATA WRAPPER postgres_fdw;
CREATE TABLE metrics_osm (time timestamptz NOT NULL, device int, value float8)
  WITH (tsdb.hypertable, tsdb.partition_column = 'time', tsdb.chunk_interval = '1 day');
INSERT INTO metrics_osm SELECT '2021-06-01'::timestamptz + g * interval '6 hours', g, g * 10 FROM generate_series(0, 8) g;
CREATE FOREIGN TABLE metrics_osm_ft (time timestamptz NOT NULL, device int, value float8) SERVER dcs_osm_fdw;
SELECT _timescaledb_functions.attach_osm_table_chunk('metrics_osm', 'metrics_osm_ft');
 attach_osm_table_chunk 
------------------------
 t

SELECT _timescaledb_functions.hypertable_osm_range_update('metrics_osm');  -- mark the OSM range noncontiguous
 hypertable_osm_range_update 
-----------------------------
 f

SET timescaledb.debug_require_deferred_chunk_scan TO 'forbid';
-- EXECUTE hides the version-specific foreign-scan plan; planning still trips the GUC.
DO $$ BEGIN EXECUTE 'EXPLAIN (COSTS OFF) SELECT * FROM metrics_osm ORDER BY time LIMIT 3'; END $$;
RESET timescaledb.debug_require_deferred_chunk_scan;
\c :TEST_DBNAME :ROLE_DEFAULT_PERM_USER
SET timescaledb.enable_deferred_chunk_scan TO on;
-- test correctness by diffing optimized and unoptimized results
\set TEST_BASE_NAME deferredchunkscan
SELECT format('include/%s_query.sql', :'TEST_BASE_NAME') AS "TEST_QUERY_NAME",
       format('%s/results/%s_results_optimized.out', :'TEST_OUTPUT_DIR', :'TEST_BASE_NAME') AS "TEST_RESULTS_OPTIMIZED",
       format('%s/results/%s_results_unoptimized.out', :'TEST_OUTPUT_DIR', :'TEST_BASE_NAME') AS "TEST_RESULTS_UNOPTIMIZED" \gset
SELECT format('\! diff -u --label "Unoptimized results" --label "Optimized results" %s %s', :'TEST_RESULTS_UNOPTIMIZED', :'TEST_RESULTS_OPTIMIZED') AS "DIFF_CMD" \gset
SET timescaledb.enable_deferred_chunk_scan TO on;
SET timescaledb.debug_require_deferred_chunk_scan TO 'require';
\ir :TEST_QUERY_NAME
