\o
-- compare gapfill vs. time_bucket results over same rows
:DIFF_CMD
-- do not display aggregate
\set COUNT ''
-- Obtain "time_bucket" results over all rows
\set START max
\o :TEST_RESULTS_TIMEBUCKET
\ir :TEST_QUERY_NAME
