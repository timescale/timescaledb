  $$time_bucket_gapfill('7 days'::interval, ts, NULL::interval, '2024-02-10'::date,
                        '2024-01-20'::date, '2024-03-25'::date)$$,
  $$generate_series('2024-01-20'::date, '2024-03-25'::date, '1 day')$$
);
