-- Origins
-- Date origin
\set TABLE tb_date
SELECT time_bucket_gapfill(
    '5 days'::interval,
    ts,
    NULL,
    '1970-01-01',  --unix epoch
    (SELECT :START(ts) FROM :TABLE), (SELECT max(ts) FROM :TABLE)
):COUNT
FROM :TABLE WHERE :FILTER
GROUP BY 1 ORDER BY 1;
SELECT time_bucket_gapfill(
    '5 days'::interval,
    ts,
    NULL,
    '2020-01-01',  -- origin within data set
    (SELECT :START(ts) FROM :TABLE), (SELECT max(ts) FROM :TABLE)
):COUNT
FROM :TABLE WHERE :FILTER
GROUP BY 1 ORDER BY 1;
-- Timestamp origin
\set TABLE tb_ts
SELECT time_bucket_gapfill(
    '5 days'::interval,
    ts,
    NULL,
    '1970-01-01',  --unix epoch
    (SELECT :START(ts) FROM :TABLE), (SELECT max(ts) FROM :TABLE)
):COUNT
FROM :TABLE WHERE :FILTER
GROUP BY 1 ORDER BY 1;
SELECT time_bucket_gapfill(
    '5 days'::interval,
    ts,
    NULL,
    '2020-01-07',  -- origin within data set, Tuesday
    (SELECT :START(ts) FROM :TABLE), (SELECT max(ts) FROM :TABLE)
):COUNT
FROM :TABLE WHERE :FILTER
GROUP BY 1 ORDER BY 1;
-- TimestampTz origin
\set TABLE tb_tstz
SELECT time_bucket_gapfill(
    '5 days'::interval,
    ts,
    NULL,
    '1970-01-01',  --unix epoch
    (SELECT :START(ts) FROM :TABLE), (SELECT max(ts) FROM :TABLE)
):COUNT
FROM :TABLE WHERE :FILTER
GROUP BY 1 ORDER BY 1;
SELECT time_bucket_gapfill(
    '5 days'::interval,
    ts,
    NULL,
    '2020-01-07',  -- origin within data set, Tuesday
    (SELECT :START(ts) FROM :TABLE), (SELECT max(ts) FROM :TABLE)
):COUNT
FROM :TABLE WHERE :FILTER
GROUP BY 1 ORDER BY 1;
-- TimestampTz with time zone
\set TABLE tb_timetz
SELECT time_bucket_gapfill(
    '1hour'::interval,
    ts,
    'Europe/Berlin',
    NULL,
    '1970-01-01',  --unix epoch
    (SELECT :START(ts) FROM :TABLE), (SELECT max(ts) FROM :TABLE)
):COUNT
FROM :TABLE WHERE :FILTER
GROUP BY 1 ORDER BY 1;
SELECT time_bucket_gapfill(
    '1hour'::interval,
    ts,
    'Europe/Berlin',
    NULL,
    '2025-10-25 23:05:00+00',  --origin within data set, before DST switch
    (SELECT :START(ts) FROM :TABLE), (SELECT max(ts) FROM :TABLE)
):COUNT
FROM :TABLE WHERE :FILTER
GROUP BY 1 ORDER BY 1;
SELECT time_bucket_gapfill(
    '1hour'::interval,
    ts,
    'Europe/Berlin',
    NULL,
    '2025-10-26 00:59:00+00',  --origin within data set, after DST switch
    (SELECT :START(ts) FROM :TABLE), (SELECT max(ts) FROM :TABLE)
):COUNT
FROM :TABLE WHERE :FILTER
GROUP BY 1 ORDER BY 1;
-- origin + offset
SELECT time_bucket_gapfill(
    '1hour'::interval,
    ts,
    'Europe/Berlin',
    '-15 min'::interval, -- negative offset
    '1970-01-01',  --unix epoch
    (SELECT :START(ts) FROM :TABLE), (SELECT max(ts) FROM :TABLE)
):COUNT
FROM :TABLE WHERE :FILTER
GROUP BY 1 ORDER BY 1;
SELECT time_bucket_gapfill(
    '1hour'::interval,
    ts,
    'Europe/Berlin',
    '-15 min'::interval, -- negative offset
    '2025-10-25 23:05:00+00',  --origin within data set, before DST switch
    (SELECT :START(ts) FROM :TABLE), (SELECT max(ts) FROM :TABLE)
):COUNT
FROM :TABLE WHERE :FILTER
GROUP BY 1 ORDER BY 1;
SELECT time_bucket_gapfill(
    '1hour'::interval,
    ts,
    'Europe/Berlin',
    '-15 min'::interval, -- negative offset
