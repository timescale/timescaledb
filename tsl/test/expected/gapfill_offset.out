GROUP BY 1 ORDER BY 1;
-- NULL offset and origin: should produce results as if with no offset and origin
\set TABLE tb_int
SELECT time_bucket_gapfill(
    5,
    ts,
    NULL,
    (SELECT :START(ts) FROM :TABLE), (SELECT max(ts) FROM :TABLE)
):COUNT
FROM :TABLE WHERE :FILTER
GROUP BY 1 ORDER BY 1;
\set TABLE tb_ts
SELECT time_bucket_gapfill(
    '5 days'::interval,
    ts,
    NULL,
    NULL,
    (SELECT :START(ts) FROM :TABLE), (SELECT max(ts) FROM :TABLE)
):COUNT
FROM :TABLE WHERE :FILTER
GROUP BY 1 ORDER BY 1;
\set TABLE tb_tstz
SELECT time_bucket_gapfill(
    '5 days'::interval,
    ts,
    'Europe/Berlin',
    NULL,
    NULL,
    (SELECT :START(ts) FROM :TABLE), (SELECT max(ts) FROM :TABLE)
):COUNT
FROM :TABLE WHERE :FILTER
GROUP BY 1 ORDER BY 1;
\o
-- Obtain "time_bucket" results over all rows
\set START max
\o :TEST_RESULTS_TIMEBUCKET
\ir :TEST_QUERY_NAME
