 \x37       | -0.499115410260856
 \x31313438 | -0.497002002550289
 \x36       | -0.496185038238764
 \x35       | -0.496127981692553
 \x31393630 | -0.495526578277349
 \x31303638 | -0.494831068208441

reset timescaledb.enable_bulk_decompression;
reset timescaledb.debug_require_vector_agg;
