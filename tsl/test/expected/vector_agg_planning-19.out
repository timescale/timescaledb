               mx              | mn  | device 
-- A primary key makes an ungrouped column functionally dependent on
-- the GROUP BY keys, so the select list can use it without
-- aggregation.
CREATE TABLE fdmetrics(
    ts timestamptz NOT NULL,
    id int NOT NULL,
    label text,
    value float,
    PRIMARY KEY (id, ts)
) WITH (tsdb.hypertable, tsdb.partition_column='ts', tsdb.segmentby='id', tsdb.orderby='ts');
INSERT INTO fdmetrics
SELECT '2025-01-01'::timestamptz + format('%s h', i / 5)::interval,
       i % 5, 'label ' || (i % 5)::text, i
FROM generate_series(1, 20) i;
SELECT count(compress_chunk(c)) FROM show_chunks('fdmetrics') c;
 count 
-------
     1

EXPLAIN (costs off) SELECT id, ts, label, sum(value) FROM fdmetrics GROUP BY id, ts ORDER BY id, ts;
--- QUERY PLAN ---
 Finalize GroupAggregate
   Group Key: _hyper_2_3_chunk.id, _hyper_2_3_chunk.ts
   ->  Custom Scan (VectorAgg)
         ->  Custom Scan (ColumnarScan) on _hyper_2_3_chunk
               ->  Index Scan using _hyper_2_3_chunk_compressed_id__ts_meta_v2_first_ts__ts_met_idx on _hyper_2_3_chunk_compressed

