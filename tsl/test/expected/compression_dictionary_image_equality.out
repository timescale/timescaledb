-- Dictionary compression must not merge values that compare equal with the
-- type's equality operator but are not identical, since they can still be
-- distinguished (e.g. by their text output or by arithmetic). See #10709.
CREATE DOMAIN dict_numeric AS numeric;
CREATE TABLE dict_image_eq (
	ts int NOT NULL,
	i interval,
	j jsonb,
	n dict_numeric,
	a float8[]
);
SELECT create_hypertable('dict_image_eq', 'ts', chunk_time_interval => 1000);
     create_hypertable      
----------------------------
 (1,public,dict_image_eq,t)

ALTER TABLE dict_image_eq SET (timescaledb.compress,
	timescaledb.compress_segmentby = '',
	timescaledb.compress_orderby = 'ts');
-- repeat the values so that the dictionary compression is used
INSERT INTO dict_image_eq
SELECT g * 10 + v.k, v.i::interval, v.j::jsonb, v.n::dict_numeric, v.a::float8[]
FROM generate_series(0, 49) g, (VALUES
	(1, '30 days',         '{"a": 1.0}',  1.0,   '{0}'),
	(2, '1 mon',           '{"a": 1.00}', 1.00,  '{-0}'),
	(3, '24:00:00',        '{"a": 1}',    1,     '{0}'),
	(4, '1 day',           '{"a": 1.0}',  1.000, '{-0}'),
	(5, '-1 mons 30 days', '{"a": 1.00}', 1.0,   '{0}'),
	(6, '0',               NULL,          NULL,  NULL),
	(7, '1 mon',           '{"a": 1}',    1.00,  '{-0}')) v(k, i, j, n, a);
-- keep a copy of the original values to compare with
CREATE TABLE dict_image_eq_orig AS SELECT * FROM dict_image_eq;
CREATE VIEW dict_image_eq_diff AS
SELECT ts,
	o.i AS orig_i, t.i,
	o.j AS orig_j, t.j,
	o.n AS orig_n, t.n,
	o.a AS orig_a, t.a
FROM dict_image_eq t FULL JOIN dict_image_eq_orig o USING (ts)
WHERE t.i::text IS DISTINCT FROM o.i::text
	OR t.j::text IS DISTINCT FROM o.j::text
	OR t.n::text IS DISTINCT FROM o.n::text
	OR t.a::text IS DISTINCT FROM o.a::text;
SELECT ts, i, '2024-01-31'::date + i AS jan31_plus_i, j, n, a
FROM dict_image_eq WHERE ts < 10 ORDER BY ts;
 ts |          i           |       jan31_plus_i       |      j      |   n   |  a   
----+----------------------+--------------------------+-------------+-------+------
  1 | @ 30 days            | Fri Mar 01 00:00:00 2024 | {"a": 1.0}  |   1.0 | {0}
  2 | @ 1 mon              | Thu Feb 29 00:00:00 2024 | {"a": 1.00} |  1.00 | {-0}
  3 | @ 24 hours           | Thu Feb 01 00:00:00 2024 | {"a": 1}    |     1 | {0}
  4 | @ 1 day              | Thu Feb 01 00:00:00 2024 | {"a": 1.0}  | 1.000 | {-0}
  5 | @ 1 mon -30 days ago | Tue Jan 30 00:00:00 2024 | {"a": 1.00} |   1.0 | {0}
  6 | @ 0                  | Wed Jan 31 00:00:00 2024 |             |       | 
  7 | @ 1 mon              | Thu Feb 29 00:00:00 2024 | {"a": 1}    |  1.00 | {-0}

SELECT count(compress_chunk(c)) FROM show_chunks('dict_image_eq') c;
 count 
-------
     1

SELECT cs.compress_relid AS "COMPRESSED_CHUNK"
FROM show_chunks('dict_image_eq') c
JOIN _timescaledb_catalog.compression_settings cs ON cs.relid = c \gset
-- all columns should use dictionary compression
SELECT _timescaledb_functions.compressed_data_info(i) AS i,
	_timescaledb_functions.compressed_data_info(j) AS j,
	_timescaledb_functions.compressed_data_info(n) AS n,
	_timescaledb_functions.compressed_data_info(a) AS a
FROM :COMPRESSED_CHUNK;
       i        |       j        |       n        |       a        
----------------+----------------+----------------+----------------
 (DICTIONARY,f) | (DICTIONARY,t) | (DICTIONARY,t) | (DICTIONARY,t)

-- values must be unchanged, both with bulk and row-by-row decompression
SELECT ts, i, '2024-01-31'::date + i AS jan31_plus_i, j, n, a
FROM dict_image_eq WHERE ts < 10 ORDER BY ts;
 ts |          i           |       jan31_plus_i       |      j      |   n   |  a   
----+----------------------+--------------------------+-------------+-------+------
  1 | @ 30 days            | Fri Mar 01 00:00:00 2024 | {"a": 1.0}  |   1.0 | {0}
  2 | @ 1 mon              | Thu Feb 29 00:00:00 2024 | {"a": 1.00} |  1.00 | {-0}
  3 | @ 24 hours           | Thu Feb 01 00:00:00 2024 | {"a": 1}    |     1 | {0}
  4 | @ 1 day              | Thu Feb 01 00:00:00 2024 | {"a": 1.0}  | 1.000 | {-0}
  5 | @ 1 mon -30 days ago | Tue Jan 30 00:00:00 2024 | {"a": 1.00} |   1.0 | {0}
  6 | @ 0                  | Wed Jan 31 00:00:00 2024 |             |       | 
  7 | @ 1 mon              | Thu Feb 29 00:00:00 2024 | {"a": 1}    |  1.00 | {-0}

SELECT * FROM dict_image_eq_diff;
 ts | orig_i | i | orig_j | j | orig_n | n | orig_a | a 
----+--------+---+--------+---+--------+---+--------+---

SET timescaledb.enable_bulk_decompression = off;
SELECT * FROM dict_image_eq_diff;
 ts | orig_i | i | orig_j | j | orig_n | n | orig_a | a 
----+--------+---+--------+---+--------+---+--------+---

RESET timescaledb.enable_bulk_decompression;
-- filters on the compressed chunk still use the type's equality
SELECT i::text, count(*) FROM dict_image_eq WHERE i = '1 mon' GROUP BY 1 ORDER BY 1;
     i     | count 
-----------+-------
 @ 1 mon   |   100
 @ 30 days |    50

SELECT i::text, count(*) FROM dict_image_eq WHERE i = '1 day' GROUP BY 1 ORDER BY 1;
     i      | count 
------------+-------
 @ 1 day    |    50
 @ 24 hours |    50

SELECT count(decompress_chunk(c)) FROM show_chunks('dict_image_eq') c;
 count 
-------
     1

SELECT * FROM dict_image_eq_diff;
 ts | orig_i | i | orig_j | j | orig_n | n | orig_a | a 
----+--------+---+--------+---+--------+---+--------+---

DROP VIEW dict_image_eq_diff;
DROP TABLE dict_image_eq;
DROP TABLE dict_image_eq_orig;
DROP DOMAIN dict_numeric;
-- A batch with mostly distinct values is converted from the dictionary to
-- ARRAY at the end, using the deduplicated dictionary, so the values must
-- not be merged on that path either. 990 rows have distinct intervals in
-- days and the last 10 rows repeat the first 10 values in hours.
CREATE TABLE dict_image_eq_array (ts int NOT NULL, i interval);
SELECT create_hypertable('dict_image_eq_array', 'ts', chunk_time_interval => 10000);
        create_hypertable         
----------------------------------
 (2,public,dict_image_eq_array,t)

ALTER TABLE dict_image_eq_array SET (timescaledb.compress,
	timescaledb.compress_segmentby = '',
	timescaledb.compress_orderby = 'ts');
INSERT INTO dict_image_eq_array
SELECT ts, CASE WHEN ts <= 990 THEN make_interval(days => ts)
	ELSE make_interval(hours => 24 * (ts - 990)) END
FROM generate_series(1, 1000) ts;
CREATE TABLE dict_image_eq_array_orig AS SELECT * FROM dict_image_eq_array;
CREATE VIEW dict_image_eq_array_diff AS
SELECT ts, o.i AS orig_i, t.i
FROM dict_image_eq_array t FULL JOIN dict_image_eq_array_orig o USING (ts)
WHERE t.i::text IS DISTINCT FROM o.i::text;
SELECT count(compress_chunk(c)) FROM show_chunks('dict_image_eq_array') c;
 count 
-------
     1

SELECT cs.compress_relid AS "COMPRESSED_CHUNK"
FROM show_chunks('dict_image_eq_array') c
JOIN _timescaledb_catalog.compression_settings cs ON cs.relid = c \gset
-- a single batch, stored as ARRAY
SELECT count(*), _timescaledb_functions.compressed_data_info(i) AS i
FROM :COMPRESSED_CHUNK GROUP BY 2;
 count |     i     
-------+-----------
     1 | (ARRAY,f)

SELECT ts, i FROM dict_image_eq_array WHERE ts IN (1, 2, 991, 992) ORDER BY ts;
 ts  |     i      
-----+------------
   1 | @ 1 day
   2 | @ 2 days
 991 | @ 24 hours
 992 | @ 48 hours

SELECT * FROM dict_image_eq_array_diff;
 ts | orig_i | i 
----+--------+---

SET timescaledb.enable_bulk_decompression = off;
SELECT * FROM dict_image_eq_array_diff;
 ts | orig_i | i 
----+--------+---

RESET timescaledb.enable_bulk_decompression;
DROP VIEW dict_image_eq_array_diff;
DROP TABLE dict_image_eq_array;
DROP TABLE dict_image_eq_array_orig;
