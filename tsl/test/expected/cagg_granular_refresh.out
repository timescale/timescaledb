-----------+------------------------------+-----
 sensor_c  | Wed Jan 01 00:00:00 2020 UTC |   3
 sensor_z  | Wed Jan 01 00:00:00 2025 UTC |   0

SELECT *
FROM continuous_aggs_tenant_tracking_view
