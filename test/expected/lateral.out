         Filter: (device_id = $1)
   ->  Seq Scan on _hyper_12_127_chunk
         Filter: (device_id = $1)
   ->  Seq Scan on _hyper_12_128_chunk
         Filter: (device_id = $1)
   ->  Seq Scan on _hyper_12_129_chunk
         Filter: (device_id = $1)

DROP TABLE metric_generic;
